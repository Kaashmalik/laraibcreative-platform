# ===========================================
# LaraibCreative Frontend - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values.
# The frontend talks to the Express/MongoDB backend over HTTP (axios).

# ===========================================
# BACKEND API (Required)
# ===========================================
# Base origin of the backend API (no trailing slash).
NEXT_PUBLIC_API_URL=https://laraibcreative-backend.onrender.com
# Full API base including version (used by some clients).
NEXT_PUBLIC_API_BASE_URL=https://laraibcreative-backend.onrender.com/api/v1
# For local development, point these at your local backend:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:5000
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5000/api/v1

# ===========================================
# SITE CONFIGURATION
# ===========================================
NEXT_PUBLIC_SITE_URL=https://laraibcreative.studio
NEXT_PUBLIC_APP_URL=https://laraibcreative.studio
NEXT_PUBLIC_SITE_NAME=LaraibCreative

# ===========================================
# CLOUDINARY (image delivery / uploads)
# ===========================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
# Server-side only (used by the Next.js /api/upload route):
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ===========================================
# ANALYTICS (Optional)
# ===========================================
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FB_PIXEL_ID=your-facebook-pixel-id
